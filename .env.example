# --- Подключение к CVAT ---
# Для локального запуска uvicorn на хосте:
CVAT_HOST=http://localhost:8080
# Для запуска сервиса в Docker-сети CVAT:
CVAT_DOCKER_HOST=http://cvat_server:8080
CVAT_DOCKER_NETWORK=cvat_cvat

CVAT_USER=admin
CVAT_PASS=admin
SERVICE_PORT=8000

# --- Предзагрузка моделей при старте (пусто = ленивая загрузка) ---
# Пример: PRELOAD_MODELS=yoloe
PRELOAD_MODELS=

# --- Настройки YOLOE ---
YOLOE_WEIGHTS=yoloe-11s-seg.pt
YOLOE_CONF=0.25
YOLOE_IMGSZ=640
# auto / cpu / cuda (пусто = автовыбор)
YOLOE_DEVICE=auto

# --- Настройки DART (SAM 3) ---
# Пусто -> автоматическая загрузка facebook/sam3 из HuggingFace (требуется HF_TOKEN)
DART_CHECKPOINT=
DART_CONF=0.3
DART_NMS=0.5
DART_IMGSZ=1008
# cpu / cuda / auto
DART_DEVICE=cpu

# Токен HuggingFace (нужен при первом скачивании facebook/sam3)
HF_TOKEN=

# --- Параметры Docker-сборки и кэша ---
HF_CACHE_DIR=~/.cache/huggingface
# Для GPU замените на https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
DOCKER_YOLOE_WEIGHTS=/app/weights/yoloe-11s-seg.pt
